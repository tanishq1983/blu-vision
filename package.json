{
  "name": "blu-visual-teacher", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node -r ./scripts/tsx-userinfo-shim.cjs --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1 --configLoader runner\"",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "start": "node -r ./scripts/tsx-userinfo-shim.cjs --import tsx server/index.ts",
    "test": "vitest run --configLoader runner --passWithNoTests",
    "test:e2e": "tsx scripts/e2e.ts",
    "seed": "tsx scripts/seed.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.2.5", "@fontsource/noto-sans-devanagari": "5.2.5", "@fontsource/noto-sans-kannada": "5.2.5",
    "cors": "2.8.5", "dotenv": "16.5.0", "express": "5.1.0", "ffmpeg-static": "5.2.0", "ffprobe-static": "3.1.0",
    "playwright": "1.56.1", "react": "19.1.0", "react-dom": "19.1.0", "zod": "3.24.2", "zod-to-json-schema": "3.24.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.17", "@types/express": "5.0.1", "@types/node": "22.15.3", "@types/react": "19.1.2", "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1", "autoprefixer": "10.4.21", "concurrently": "9.1.2", "postcss": "8.5.3", "tailwindcss": "3.4.17", "tsx": "4.19.4", "typescript": "5.8.3", "vite": "6.3.4", "vitest": "3.1.2"
  }
}
